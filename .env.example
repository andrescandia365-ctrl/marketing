# Copy to .env and fill in what you have. Everything is optional: with nothing set,
# the app runs in sample mode with placeholder images.

# Who writes (menu, story, storyboard, explainers): pick it in the app (Modelos, top right), which also saves the
# keys here. Or set them by hand. LLM_PROVIDER: claude, moonshot, nvidia or openrouter; without it, Claude if its key
# is set, else the first provider with a key.
# LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# WRITER_EFFORT=high

# OpenAI-compatible providers, each with its own key and model.
MOONSHOT_API_KEY=
# MOONSHOT_MODEL=kimi-k3
NVIDIA_API_KEY=
# NVIDIA_MODEL=moonshotai/kimi-k3
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=moonshotai/kimi-k3

# Who looks at pictures (review of uploads, the explainers' quality loop). Empty: the writer.
# VISION_PROVIDER=claude
# VISION_MODEL=claude-opus-5-5

# Any other OpenAI-compatible gateway (also the older setup): LLM_PROVIDER=kimi with these.
# China accounts of Moonshot: KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_API_KEY=
# KIMI_MODEL=kimi-k3
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# Optional; when unset Kimi uses its default (the deepest, slowest reasoning).
# KIMI_REASONING_EFFORT=
# Lower = invents less (e.g. 0.6). Left out, Kimi uses its own; if the model rejects it, the app drops it.
# KIMI_TEMPERATURE=
# Room for reasoning + answer (default 32768). If your provider rejects it, the app drops it.
# KIMI_MAX_TOKENS=32768

# Image generators: set one or both. OPENAI_API_KEY also powers "Voz generada" (OpenAI's speech API).
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
# Lyric videos: automatic sync transcribes the song with word times (whisper-1 returns them).
# OPENAI_TRANSCRIBE_MODEL=whisper-1
REPLICATE_API_TOKEN=
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# Final render of explainers (node render.mjs + ffmpeg) opens Google Chrome; another browser by its path:
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# PORT=8787
