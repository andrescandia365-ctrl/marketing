# Copy to .env and fill in what you have. Everything is optional: with nothing set,
# the app runs in sample mode with placeholder images.

# The model that writes the topic menu, the story and the storyboard: Claude or Kimi.
# With both keys set, Claude is used unless LLM_PROVIDER=kimi.
# LLM_PROVIDER=kimi
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Kimi (Moonshot AI), OpenAI-compatible API. China accounts: KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=
# KIMI_MODEL=kimi-k3
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# Optional; when unset Kimi uses its default (the deepest, slowest reasoning).
# KIMI_REASONING_EFFORT=

# Image generators: set one or both. OPENAI_API_KEY also powers "Voz generada" (OpenAI's speech API).
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
REPLICATE_API_TOKEN=
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# PORT=8787
